                    ],
                    "explicitBounds": [
                      0.1
                    ],
                    "attributes": [
                      {
                        "key": "specmatrix_run",
                        "value": {
                          "stringValue": "{{ run_key }}"
                        }
                      }
                    ]
                  }
                ]
              }
            }
          ]
        }
      ]
    }
  ]
